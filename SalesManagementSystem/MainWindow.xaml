<Window x:Class="SalesManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Система управления продажами"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        Background="#F3F5F7"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DEE5" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style x:Key="MetricBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DEE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="18,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="120"
                                 Height="8"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Margin="0,0,12,0" />
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Система управления продажами"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#CBD5E1"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="12">
            <TabItem Header="Панель">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="5">
                        <Border Style="{StaticResource MetricBorder}">
                            <StackPanel>
                                <TextBlock Text="Товары" Foreground="#64748B" />
                                <TextBlock Text="{Binding Summary.ProductCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricBorder}">
                            <StackPanel>
                                <TextBlock Text="Клиенты" Foreground="#64748B" />
                                <TextBlock Text="{Binding Summary.CustomerCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricBorder}">
                            <StackPanel>
                                <TextBlock Text="Заказы" Foreground="#64748B" />
                                <TextBlock Text="{Binding Summary.OrderCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricBorder}">
                            <StackPanel>
                                <TextBlock Text="Выручка" Foreground="#64748B" />
                                <TextBlock Text="{Binding Summary.Revenue, StringFormat={}{0:C}}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricBorder}">
                            <StackPanel>
                                <TextBlock Text="Мало на складе" Foreground="#64748B" />
                                <TextBlock Text="{Binding Summary.LowStockCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <GroupBox Grid.Row="1" Header="Последние заказы">
                        <DataGrid ItemsSource="{Binding Orders}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="140" />
                                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
                                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:C}}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Товары">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="110" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="110" />
                            <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="90" />
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="1" Header="Карточка товара">
                        <StackPanel>
                            <TextBlock Text="Артикул" />
                            <TextBox Text="{Binding SelectedProduct.Sku, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Наименование" />
                            <TextBox Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Категория" />
                            <TextBox Text="{Binding SelectedProduct.Category, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Цена" />
                            <TextBox Text="{Binding SelectedProduct.UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Остаток на складе" />
                            <TextBox Text="{Binding SelectedProduct.StockQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Товар активен"
                                      IsChecked="{Binding SelectedProduct.IsActive}"
                                      Margin="0,2,0,14" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Новый" Command="{Binding NewProductCommand}" />
                                <Button Content="Сохранить" Command="{Binding SaveProductCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Клиенты">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Организация" Binding="{Binding CompanyName}" Width="*" />
                            <DataGridTextColumn Header="Контакт" Binding="{Binding ContactName}" Width="160" />
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="1" Header="Карточка клиента">
                        <StackPanel>
                            <TextBlock Text="Организация" />
                            <TextBox Text="{Binding SelectedCustomer.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Контактное лицо" />
                            <TextBox Text="{Binding SelectedCustomer.ContactName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Телефон" />
                            <TextBox Text="{Binding SelectedCustomer.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding SelectedCustomer.Email, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Адрес" />
                            <TextBox Text="{Binding SelectedCustomer.Address, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="74"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Новый" Command="{Binding NewCustomerCommand}" />
                                <Button Content="Сохранить" Command="{Binding SaveCustomerCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="Создание заказа">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Клиент" />
                                <ComboBox ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding OrderCustomer}"
                                          DisplayMemberPath="CompanyName" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Товар" />
                                <ComboBox ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding OrderProduct}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Кол-во" />
                                <TextBox Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button Content="Добавить позицию" Command="{Binding AddOrderItemCommand}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="12,0">
                                <TextBlock Text="Комментарий" />
                                <TextBox Text="{Binding OrderComment, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding DraftTotal, StringFormat=Итого: {0:C}}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,8" />
                                <Button Content="Создать заказ" Command="{Binding CreateOrderCommand}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Column="0" Grid.RowSpan="2" Header="Журнал заказов">
                            <DataGrid ItemsSource="{Binding Orders}"
                                      SelectedItem="{Binding SelectedOrder}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="130" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                                    <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" />
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:C}}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Grid.Row="0" Header="Черновик заказа">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Удалить позицию" Command="{Binding RemoveOrderItemCommand}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding DraftItems}"
                                          SelectedItem="{Binding SelectedDraftItem}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
                                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="110" />
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Grid.Row="1" Header="Состав выбранного заказа">
                            <DataGrid ItemsSource="{Binding SelectedOrderItems}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
                                    <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="110" />
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
